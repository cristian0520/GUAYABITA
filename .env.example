# Copia este archivo a ".env" y completa los valores.
# Si dejas TURSO_DATABASE_URL vacío, el juego usa un SQLite local (solo para probar).

# Obtenerlo con:  turso db show guayabita --url
TURSO_DATABASE_URL=libsql://guayabita-TUUSUARIO.turso.io

# Obtenerlo con:  turso db tokens create guayabita
TURSO_AUTH_TOKEN=
